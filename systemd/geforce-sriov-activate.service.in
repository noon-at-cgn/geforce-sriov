# SPDX-License-Identifier: MIT
# geforce-sriov @VERSION@: run the complete activation before display and VM autostart.
# The transaction starts NVIDIA's daemons itself; it must not be ordered after them.
# Boot activation never prompts or stops a running display manager.
# Add geforce_sriov.skip to the kernel command line to skip this boot.
[Unit]
Description=geforce-sriov: activate selected GPUs
After=geforce-sriov-livepatch.service
Before=display-manager.service libvirt-guests.service pve-guests.service
# nvidia-persistenced opens every GPU. It must not hold one while the card is removed and rescanned.
Before=nvidia-persistenced.service
ConditionPathExists=/etc/geforce-sriov/config
ConditionKernelCommandLine=!geforce_sriov.skip
RequiresMountsFor=/var/lib/geforce-sriov @BINDIR@

[Service]
Type=oneshot
ExecStart=@BINDIR@/geforce-sriov activate --boot
RemainAfterExit=yes
# TimeoutStartSec is written by install: an upper bound of activation, the sum of its own limits
# (every wait, write and process at its limit, per selected card and VF; at least 900 s). The
# waiting loops end on elapsed time, so activation ends through its own limits before systemd does,
# even on a systemd that ignores the extension below (the manual names only Type=notify; measured on
# systemd 257.13 only). Normal activation takes seconds per card; the value matters only in a real
# hang. The selection and the VF count change through install, which rewrites this unit.
# Before each step that can wait, the CLI also sends EXTEND_TIMEOUT_USEC (that step's own limit
# plus a margin) to the notify socket.
NotifyAccess=main
TimeoutStartSec=@START_TIMEOUT@
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
